[gd_scene load_steps=3 format=3]

[ext_resource type="Script" path="res://src/UI/Screens/game_over.gd" id="1_script"]
[ext_resource type="PackedScene" path="res://src/Levels/Shared/background.tscn" id="2_background"]

[node name="GameOver" type="Control"]
layout_mode = 3
anchors_preset = 15
anchor_right = 1.0
anchor_bottom = 1.0
grow_horizontal = 2
grow_vertical = 2
