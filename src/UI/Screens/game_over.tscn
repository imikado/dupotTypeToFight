[node name="ScoreLabel" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(1, 0.823529, 0.247059, 1)
theme_override_font_sizes/font_size = 16
text = "0"
