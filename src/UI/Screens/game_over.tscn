level_scene_path = "res://src/Levels/level.tscn"
menu_scene_path = "res://src/UI/Screens/Menu.tscn"

[node name="Background" parent="." instance=ExtResource("2_background")]

[node name="Panel" type="PanelContainer" parent="."]
layout_mode = 1
anchors_preset = 8
anchor_left = 0.5
anchor_top = 0.5
anchor_right = 0.5
anchor_bottom = 0.5
offset_left = -150.0
offset_top = -80.0
offset_right = 150.0
offset_bottom = 80.0
grow_horizontal = 2
grow_vertical = 2

[node name="VBoxContainer" type="VBoxContainer" parent="Panel"]
layout_mode = 2
alignment = 1
theme_override_constants/separation = 6

[node name="Title" type="Label" parent="Panel/VBoxContainer"]
layout_mode = 2
theme_override_colors/font_color = Color(0.85, 0.15, 0.25, 1)
theme_override_font_sizes/font_size = 18
text = "GAME_OVER"
